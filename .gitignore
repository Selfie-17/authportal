# Root .gitignore
.env
.env.*
!.env.example
*.log
.idea/
target/
# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
/storage/
/authportal/storage/
!**/src/**/storage/

# Google Cloud Service Account Keys (NEVER commit secrets to source control)
*gcp*.json
*service-account*.json
*credentials*.json
gcs-key*.json
secrets/

# Load testing binaries, diagnostics, and benchmark artifacts
load-testing/bin/
*.exe
*-monitor.csv
*.csv
peak_threads.json
test_run_metrics.prom
