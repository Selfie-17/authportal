# ==============================================================================
# Auth Portal — Environment Configuration Example
# Copy this file to .env and replace placeholder values with real secrets.
# NEVER commit your actual .env file or production secrets to source control.
# ==============================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/authportal?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password_here

# JWT Configuration
# Generate a strong 256-bit (or 512-bit) secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_signing_key_must_be_at_least_256_bits_long
JWT_EXPIRATION=86400000

# Google OAuth 2.0 / OIDC Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Application URL (for CORS & OAuth Redirect Callback)
FRONTEND_URL=http://localhost:5173

# Teacher Allowed Emails (comma-separated list of approved institutional teacher emails)
TEACHER_ALLOWED_EMAILS=hod.cse@rguktn.ac.in,dean@rguktn.ac.in,faculty1@rguktn.ac.in

# Google OAuth Admin Emails (comma-separated list of accounts granted ADMIN strictly via Google OAuth)
GOOGLE_ADMIN_EMAILS=uday@rguktn.ac.in,kampadevaselvaraj@gmail.com
